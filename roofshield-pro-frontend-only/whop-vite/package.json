{
  "name": "roofshield-pro-whop",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "deploy": "whop apps deploy",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "deploy:verify": "node scripts/deploy-and-verify.mjs",
    "verify:live": "node scripts/deploy-and-verify.mjs --skip-deploy",
    "artifact:serve": "node scripts/serve-artifact.mjs --env-file .env --static",
    "verify:artifact": "node scripts/verify-artifact.mjs --env-file .env"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "@whop/elements": "^1.9.0",
    "@whop/elements-react": "^1.9.0",
    "@whop/sdk": "^2.7.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.70.0",
    "pg": "8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@whop/cli": "^0.34.1",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "wrangler": "^4.158.0"
  }
}

# ROOFSHIELD PRO — server-side configuration
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# All of these are server-only; none are exposed to the browser bundle.
# On Whop hosting, set them as app secrets instead:
#   whop apps secrets set --secret WHOP_API_KEY=...

# ── Whop production credentials ─────────────────────────────────────────────
# The existing company API key. Do not create a new one.
WHOP_API_KEY=
# The business (account) id, prefixed biz_.
WHOP_ACCOUNT_ID=

# ── Whop plan ids (variant ids, prefixed plan_) ─────────────────────────────
# These are PLAN (variant) ids — never product (prod_) ids.
WHOP_PLAN_ID_INSPECTION=
WHOP_PLAN_ID_DEPOSIT=
WHOP_PLAN_ID_GUTTER=
# Final balance invoice variant. Whop prices every charge from a variant, so
# the final-balance invoice needs its own plan id. Required only for
# POST /api/invoices/final.
WHOP_PLAN_ID_BALANCE=

# ── Webhooks ───────────────────────────────────────────────────────────────
# Endpoint signing secret from the Whop dashboard (ws_…). Verifies every
# delivery via @whop/sdk's Standard Webhooks verifier.
WHOP_WEBHOOK_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────────
# Bearer token for /api/admin/*. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string (the existing Supabase database). Without it the
# server falls back to a NON-DURABLE JSON file store for local development only.
DATABASE_URL=

# ── Optional ───────────────────────────────────────────────────────────────
# Public site origin, used for absolute return URLs.
SITE_URL=
